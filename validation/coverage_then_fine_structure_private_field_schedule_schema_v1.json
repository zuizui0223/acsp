{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coverage-then-fine-structure-private-field-schedule-v1",
  "title": "Private fresh-SENTINEL field allocation and effort schedule",
  "description": "Private pre-outcome schedule. Candidate references may be sensitive and this instantiated object must remain outside the public repository. Numeric values are supplied only after candidate identities exist; this schema does not choose them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "cohort_unit_ids",
    "candidate_order_public_receipt_sha256",
    "field_evaluation_contract_sha256",
    "primary_analysis_unit_identity",
    "repeated_visit_aggregation_identity",
    "repeated_visit_aggregation_rule",
    "shared_candidate_handling_identity",
    "shared_candidate_handling_rule",
    "comparator_assignment_identity",
    "arm_symmetry_identity",
    "numeric_effort_metric",
    "matched_effort_scope",
    "assignments",
    "prospective_field_outcomes_opened",
    "field_outcomes_used_to_allocate",
    "post_outcome_schedule_edits_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "cirsium-fresh-sentinel-private-field-schedule-v1"
    },
    "status": {
      "const": "PRIVATE_FIELD_ALLOCATION_AND_EFFORT_SCHEDULE_FROZEN"
    },
    "cohort_unit_ids": {
      "const": [
        "CIR02",
        "CIR06",
        "CIR12",
        "CIR13"
      ]
    },
    "candidate_order_public_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "field_evaluation_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "primary_analysis_unit_identity": {
      "type": "string",
      "minLength": 1
    },
    "repeated_visit_aggregation_identity": {
      "type": "string",
      "minLength": 1
    },
    "repeated_visit_aggregation_rule": {
      "type": "string",
      "minLength": 1
    },
    "shared_candidate_handling_identity": {
      "type": "string",
      "minLength": 1
    },
    "shared_candidate_handling_rule": {
      "type": "string",
      "minLength": 1
    },
    "comparator_assignment_identity": {
      "type": "string",
      "minLength": 1
    },
    "numeric_effort_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "unit",
        "formula"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "formula": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "matched_effort_scope": {
      "const": "WITHIN_COHORT_UNIT_ACROSS_ALL_THREE_ARMS"
    },
    "assignments": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cohort_unit_id",
          "analysis_unit_id",
          "private_candidate_ref",
          "method_arm",
          "visit_index",
          "planned_effort_value",
          "planned_search_minutes",
          "planned_observer_count"
        ],
        "properties": {
          "cohort_unit_id": {
            "enum": [
              "CIR02",
              "CIR06",
              "CIR12",
              "CIR13"
            ]
          },
          "analysis_unit_id": {
            "type": "string",
            "minLength": 1
          },
          "private_candidate_ref": {
            "type": "string",
            "minLength": 1
          },
          "method_arm": {
            "enum": [
              "COVERAGE_THEN_FINE_STRUCTURE_V1",
              "COVERAGE_ONLY_STABLE_WITHIN_CELL_V1",
              "MORTON_DYADIC_COVERAGE_ORDER_V1"
            ]
          },
          "visit_index": {
            "type": "integer",
            "minimum": 1
          },
          "planned_effort_value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "planned_search_minutes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "planned_observer_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "prospective_field_outcomes_opened": {
      "const": false
    },
    "field_outcomes_used_to_allocate": {
      "const": false
    },
    "post_outcome_schedule_edits_allowed": {
      "const": false
    },
    "arm_symmetry_identity": {
      "const": "ARM_SYMMETRIC_PREFIX_EFFORT_TEMPLATE_V1"
    }
  }
}
