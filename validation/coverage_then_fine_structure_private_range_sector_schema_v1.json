{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acsp://coverage-then-fine-structure/private-range-sector-bundle-v1",
  "title": "Private fresh Cirsium range-sector bundle",
  "description": "Private coordinate-bearing input for CIR02/CIR06/CIR12/CIR13. The repository validator additionally enforces exactly one feature per cohort_unit_id.",
  "type": "object",
  "required": ["type", "features"],
  "additionalProperties": true,
  "properties": {
    "type": {"const": "FeatureCollection"},
    "features": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["type", "properties", "geometry"],
        "properties": {
          "type": {"const": "Feature"},
          "properties": {
            "type": "object",
            "required": ["cohort_unit_id"],
            "properties": {
              "cohort_unit_id": {
                "enum": ["CIR02", "CIR06", "CIR12", "CIR13"]
              }
            },
            "additionalProperties": true
          },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {"enum": ["Polygon", "MultiPolygon"]},
              "coordinates": {"type": "array", "minItems": 1}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  }
}
